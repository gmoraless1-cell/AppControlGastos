<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Transacciones"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Filtros -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipTodas"
            style="@style/ChipFiltro"
            android:text="Todas"
            android:selected="true" />

        <TextView
            android:id="@+id/chipIngresos"
            style="@style/ChipFiltro"
            android:layout_marginStart="8dp"
            android:text="Ingresos" />

        <TextView
            android:id="@+id/chipEgresos"
            style="@style/ChipFiltro"
            android:layout_marginStart="8dp"
            android:text="Egresos" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTransacciones"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/tvVacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="No hay transacciones todavía"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />
</LinearLayout>
