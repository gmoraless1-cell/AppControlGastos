<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado con flecha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnAtras"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                android:contentDescription="Atrás" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Registrar Transacción"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Toggle Ingreso / Egreso -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/btnIngreso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_toggle"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Ingreso"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnEgreso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_toggle"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Egreso"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Monto -->
        <TextView style="@style/LabelCampo" android:text="Monto" />
        <EditText
            android:id="@+id/etMonto"
            style="@style/CampoTexto"
            android:hint="Q 0.00"
            android:inputType="numberDecimal" />

        <!-- Categoria -->
        <TextView style="@style/LabelCampo" android:text="Categoría" />
        <Spinner
            android:id="@+id/spCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:minHeight="52dp"
            android:padding="12dp" />

        <!-- Fecha -->
        <TextView style="@style/LabelCampo" android:text="Fecha" />
        <EditText
            android:id="@+id/etFecha"
            style="@style/CampoTexto"
            android:focusable="false"
            android:clickable="true"
            android:hint="yyyy-MM-dd"
            android:inputType="none" />

        <!-- Descripcion -->
        <TextView style="@style/LabelCampo" android:text="Descripción (opcional en ingresos)" />
        <EditText
            android:id="@+id/etDescripcion"
            style="@style/CampoTexto"
            android:hint="Ej. Pago de clase, sueldo, etc."
            android:inputType="text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardar"
            style="@style/Widget.App.Button.Gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Guardar" />
    </LinearLayout>
</ScrollView>
