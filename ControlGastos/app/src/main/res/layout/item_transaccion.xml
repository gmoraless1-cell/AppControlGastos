<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <View
        android:id="@+id/viewIconoFondo"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circle_icon"
        android:backgroundTint="@color/gold" />

    <ImageView
        android:id="@+id/imgIcono"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="-34dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/ic_cat_other"
        android:contentDescription="categoría" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Descripción"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCategoriaFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Categoría · fecha"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMonto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Q 0.00"
        android:textColor="@color/green_income"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
