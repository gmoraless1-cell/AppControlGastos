<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        IMPORTANTE: parent AppCompat. MainActivity hereda de AppCompatActivity,
        asi que el tema DEBE ser Theme.AppCompat (o descendiente). Si fuera un
        tema de Compose, la app se cerraria con "You need to use a Theme.AppCompat theme".
    -->
    <style name="Theme.ControlGastos" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
    </style>
</resources>
